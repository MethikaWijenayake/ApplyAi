# =============================================================
# ApplyAI — Environment Variables Template
# =============================================================
#
# HOW TO USE THIS FILE:
# 1. In your terminal: cp .env.local.example .env.local
# 2. Open .env.local and fill in each value
# 3. NEVER commit .env.local to Git (it's in .gitignore)
# 4. Fill values in as you complete each build Part
#
# WHICH VALUES DO YOU NEED RIGHT NOW (Part 1)?
# → DATABASE_URL, REDIS_URL, NEXTAUTH_SECRET, NEXTAUTH_URL, NEXT_PUBLIC_APP_URL
# → Everything else stays as "" until we reach that build Part
#
# =============================================================

# ─── Database — needed in Part 1 ─────────────────────────────
# For local development this always matches docker-compose.yml:
# postgresql://[username]:[password]@[host]:[port]/[database_name]
# Local value: postgresql://applyai:applyai_password@localhost:5432/applyai_db
# Production: your cloud database URL (Railway, Neon, Supabase, etc.)
DATABASE_URL=""

# ─── Redis — needed in Part 1 ────────────────────────────────
# For local development this is always: redis://localhost:6379
# Production: your cloud Redis URL (Railway, Upstash, etc.)
REDIS_URL=""

# ─── NextAuth.js — needed in Part 2 ──────────────────────────
# NEXTAUTH_SECRET: a random 32-character secret string
# Generate it with: openssl rand -base64 32
# Or visit: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=""

# NEXTAUTH_URL: the URL of your app
# Local: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL=""

# ─── Google OAuth — needed in Part 2 ─────────────────────────
# How to get these: SETUP.md Section D4
# You get these from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── OpenAI — needed in Part 3 ───────────────────────────────
# How to get this: SETUP.md Section D5
# Get from: https://platform.openai.com/api-keys
# Starts with: sk-...
OPENAI_API_KEY=""

# ─── Mailgun — needed in Part 4 ──────────────────────────────
# How to get these: SETUP.md Section D6
# Sign up at: https://www.mailgun.com
# MAILGUN_DOMAIN: your sending domain e.g. mail.applyai.com
#   (use the sandbox domain for testing: sandboxXXXX.mailgun.org)
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""

# ─── AWS S3 (CV File Storage) — needed in Part 3 ─────────────
# How to get these: SETUP.md Section D7
# AWS_BUCKET_NAME: the name of your S3 bucket (e.g. applyai-cvs-yourname)
# AWS_REGION: the region of your bucket (e.g. us-east-1, eu-west-1)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""
AWS_REGION="us-east-1"

# ─── Stripe (Billing) — needed in Part 12 ────────────────────
# How to get these: SETUP.md Section D8
# Use TEST mode keys (sk_test_...) during development
# STRIPE_WEBHOOK_SECRET: created when you register a webhook endpoint in Part 12
# STRIPE_PRO_PRICE_ID: Price ID from Stripe Dashboard after creating Pro product
# STRIPE_PREMIUM_PRICE_ID: Price ID from Stripe Dashboard after creating Premium product
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_PREMIUM_PRICE_ID=""

# ─── App URL — needed in Part 1 ──────────────────────────────
# This is the publicly accessible URL of your app.
# Local: http://localhost:3000
# Production: https://yourdomain.com
# The NEXT_PUBLIC_ prefix means this value is accessible in browser-side code too.
NEXT_PUBLIC_APP_URL=""
